{
  "name": "marketplace-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.14.0" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit && node scripts/check.mjs && node scripts/build.mjs --check",
    "test": "node --test",
    "eval:lint": "vally lint plugins --eval-spec evals --strict",
    "eval:pr": "node scripts/eval.mjs --suite pr",
    "eval": "node scripts/eval.mjs --suite full",
    "eval:grade": "node scripts/eval.mjs grade",
    "verify": "npm run check && npm test && npm run eval:lint",
    "eval:report": "node scripts/report-results.mjs"
  },
  "devDependencies": {
    "@github/copilot": "1.0.98",
    "@microsoft/vally-cli": "0.19.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
